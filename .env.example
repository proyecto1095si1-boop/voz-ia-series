# Token de Hugging Face (gratis) — necesario para diarización pyannote
# Crear en: https://huggingface.co/settings/tokens
# Aceptar condiciones en: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcionales
# VOXSYNC_MODEL=large-v3
# VOXSYNC_DEVICE=auto
# VOXSYNC_SOURCE_LANG=en
# VOXSYNC_TARGET_LANG=es
